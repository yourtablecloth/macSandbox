<Configuration>
  <!-- MacSandbox sample configuration (.wsb). A schema compatible with Windows Sandbox.
       Values are Enable | Disable | Default. Unspecified fields follow the Windows Sandbox standard defaults.
       HostFolder is resolved as a macOS host path (~ expansion supported). -->

  <Networking>Enable</Networking>
  <ClipboardRedirection>Enable</ClipboardRedirection>
  <AudioInput>Enable</AudioInput>
  <PrinterRedirection>Disable</PrinterRedirection>
  <VideoInput>Disable</VideoInput>
  <VGpu>Disable</VGpu>

  <MemoryInMB>4096</MemoryInMB>
  <!-- CpuCores is a MacSandbox extension field that does not exist in Windows Sandbox -->
  <CpuCores>4</CpuCores>

  <MappedFolders>
    <MappedFolder>
      <HostFolder>~/Downloads</HostFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>

  <LogonCommand>
    <Command>cmd /c echo MacSandbox ready</Command>
  </LogonCommand>
</Configuration>
